DATABASE_URL=sqlite:///./padaria.db

# Horário de funcionamento (fora desse intervalo, movimento = alerta)
HORA_INICIO=6
HORA_FIM=22

# Notificação via Telegram (opcional - deixe em branco pra desativar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chave que o ESP32 precisa mandar pra conseguir gravar eventos (opcional -
# deixe em branco pra desativar a checagem, útil em dev/teste local)
API_KEY=

# Origens permitidas a consumir a API pelo navegador (separadas por vírgula)
CORS_ORIGINS=https://monitoramento-pequeno-comercio-iot.vercel.app,http://localhost:5173
